# Copy to .env. Every value is optional; features switch on when their values are present.
# Never commit .env.

# --- Paths (keep the private plane portable: ADR 0014) ---
# EARLYBIRD_DATA_DIR=var
# EARLYBIRD_DATABASE_URL=sqlite:///var/earlybird.db
# EARLYBIRD_PROFILE_PATH=profile.yaml
# EARLYBIRD_REGISTRY_PATH=registry/companies.yaml

# --- GitHub dataset to sync from ---
EARLYBIRD_DATASET_REPO=mohangowdatdev/earlybird

# --- LLM (optional, off by default: ADR 0007, 0012) ---
EARLYBIRD_LLM_PROVIDER=none   # none | ollama  (ollama: brew install ollama && ollama pull qwen2.5:3b)
# EARLYBIRD_LLM_MODEL=qwen2.5:3b
# EARLYBIRD_OLLAMA_URL=http://127.0.0.1:11434
# EARLYBIRD_LLM_TIME_BUDGET_SECONDS=1200
# ANTHROPIC_API_KEY=

# --- Email alerts via IMAP (Phase 2: ADR 0011) ---
# EARLYBIRD_IMAP_HOST=imap.gmail.com
# EARLYBIRD_IMAP_USER=
# EARLYBIRD_IMAP_APP_PASSWORD=
# EARLYBIRD_IMAP_LABEL=earlybird

# --- Chirp / Telegram (Phase 2) ---
# EARLYBIRD_TELEGRAM_BOT_TOKEN=
# EARLYBIRD_TELEGRAM_CHAT_ID=
# EARLYBIRD_CHIRP_DAILY_CAP=5

# --- Portal ---
# EARLYBIRD_PORTAL_HOST=127.0.0.1
# EARLYBIRD_PORTAL_PORT=8765
# EARLYBIRD_DAWN_WINDOW_DAYS=3      # Dawn shows untriaged jobs first seen in this window
# EARLYBIRD_SYNC_INTERVAL_MINUTES=60
